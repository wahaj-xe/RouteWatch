<Window x:Class="PortMTR.Enterprise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PortMTR.Enterprise.ViewModels"
        xmlns:conv="clr-namespace:PortMTR.Enterprise.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="PortMTR Enterprise  ·  Advanced Network Diagnostics"
        Height="820" Width="1380" MinHeight="640" MinWidth="1000"
        Background="{StaticResource BrBg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource MonoFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converters as static instances -->
        <conv:LossToBrushConverter   x:Key="LossToBrush"/>
        <conv:FlagToRowBrushConverter x:Key="FlagToRow"/>
        <conv:FlagToLabelConverter   x:Key="FlagToLabel"/>
        <conv:RttToStringConverter   x:Key="RttToStr"/>
        <conv:BestRttConverter       x:Key="BestRtt"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ScoreToLabelConverter  x:Key="ScoreToLabel"/>
        <conv:LocationDisplayConverter x:Key="LocationDisplay"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Banner -->
            <RowDefinition Height="Auto"/> <!-- Config bar -->
            <RowDefinition Height="Auto"/> <!-- Status bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             ROW 0 — Banner
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#010409">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="⬡" Foreground="{StaticResource BrAccent}" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="PortMTR" Foreground="{StaticResource BrAccent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" Enterprise" Foreground="#8B949E" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Subtitle -->
                <TextBlock Grid.Column="1"
                           Text="ICMP · TCP · UDP  ·  Npcap Packet Capture  ·  GeoIP  ·  Anomaly Detection  ·  Live Charts"
                           Foreground="#484F58" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>

                <!-- Elapsed + Cycles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="CYCLES " Foreground="#484F58" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CycleCount}" Foreground="{StaticResource BrAccent}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="TIME " Foreground="#484F58" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedTime}" Foreground="{StaticResource BrText}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 1 — Configuration Bar
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrPanel}"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row A: Target + Protocol + Port + Buttons -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Label Content="TARGET" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkInput}" Width="220"
                             VerticalContentAlignment="Center" Height="28"/>

                    <Label Content="PROTOCOL" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Protocols}"
                              SelectedItem="{Binding Protocol}"
                              Style="{StaticResource DarkCombo}" Width="120" Height="28"
                              VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold"
                              ItemContainerStyle="{StaticResource DarkComboItem}"/>

                    <Label Content="PORT" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Text="{Binding Port}" Style="{StaticResource DarkInput}"
                             Width="70" Height="28" VerticalContentAlignment="Center"
                             IsEnabled="{Binding PortEnabled}"/>

                    <Label Content="MAX HOPS" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Text="{Binding MaxHops}" Style="{StaticResource DarkInput}"
                             Width="55" Height="28" VerticalContentAlignment="Center"/>

                    <Label Content="INTERVAL s" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Text="{Binding Interval}" Style="{StaticResource DarkInput}"
                             Width="55" Height="28" VerticalContentAlignment="Center"/>

                    <Label Content="TIMEOUT s" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Text="{Binding ProbeTimeout}" Style="{StaticResource DarkInput}"
                             Width="55" Height="28" VerticalContentAlignment="Center"/>

                    <Label Content="PARALLEL" Style="{StaticResource FieldLabel}" Margin="12,0,4,0"/>
                    <TextBox Text="{Binding ParallelHops}" Style="{StaticResource DarkInput}"
                             Width="45" Height="28" VerticalContentAlignment="Center"/>

                    <!-- Spacer -->
                    <Rectangle Width="16"/>

                    <!-- Action Buttons -->
                    <Button Content="▶  START"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource AccentButton}"
                            Height="28" Margin="0,0,6,0"/>

                    <Button Content="■  STOP"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource StopButton}"
                            Height="28" Margin="0,0,6,0"/>

                    <Button Content="↓ HTML"
                            Command="{Binding ExportHtmlCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28" Margin="0,0,6,0"/>

                    <Button Content="↓ JSON"
                            Command="{Binding ExportJsonCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28" Margin="0,0,6,0"/>

                    <Button Content="✕ CLEAR"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource DarkButton}"
                            Height="28"/>
                </WrapPanel>

                <!-- Row B: Advanced options -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Label Content="DNS LOOKUP" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <CheckBox IsChecked="{Binding DnsEnabled}"
                              Foreground="{StaticResource BrText}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Label Content="IPv6" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                    <CheckBox IsChecked="{Binding UseIpv6}"
                              Foreground="{StaticResource BrText}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- NPCAP DEVICE - only visible for TCP/UDP -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Protocol, Converter={StaticResource BoolToVis}, ConverterParameter='ICMP'}" VerticalAlignment="Center">
                        <Label Content="NPCAP DEVICE" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  Style="{StaticResource DarkCombo}" Width="360" Height="28"
                                  VerticalContentAlignment="Center" FontSize="12" FontWeight="Bold"
                                  ItemContainerStyle="{StaticResource DarkComboItem}" Margin="0,0,16,0"/>
                    </StackPanel>

                    <!-- Stability Score -->
                    <Border Background="#1A1F27" BorderBrush="{StaticResource BrBorder}"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,0"
                            Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STABILITY " Foreground="#484F58" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StabilityScore, StringFormat=F0}"
                                       Foreground="{StaticResource BrAccent}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="/100 — " Foreground="#484F58" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StabilityLabel}"
                                       Foreground="{StaticResource BrGreen}" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 2 — Status Bar
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0C1117"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1" Height="26">
            <Grid Margin="12,0">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource BrAccent}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ResolvedIp, StringFormat='→ {0}'}"
                           Foreground="{StaticResource BrMuted}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             ROW 3 — Main Content (Grid split)
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Hop DataGrid -->
                <ColumnDefinition Width="5"/>       <!-- Splitter -->
                <ColumnDefinition Width="320"/>     <!-- Right panel -->
            </Grid.ColumnDefinitions>

            <!-- ── Hop DataGrid ───────────────────────────────────────── -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Hops}"
                      SelectedItem="{Binding SelectedHop, Mode=TwoWay}"
                      Style="{StaticResource HopGrid}"
                      Margin="0">

                <!-- Row background driven by Flag -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                                Value="{Binding Flag, Converter={StaticResource FlagToRow}}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F3A5F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2332"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- Hop -->
                    <DataGridTextColumn Header="Hop" Binding="{Binding Ttl}" Width="42">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8B949E"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Host -->
                    <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C9D1D9"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- IP -->
                    <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrAccent}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Location -->
                    <DataGridTemplateColumn Header="Location" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Country}" Foreground="#8B949E" FontSize="11"/>
                                    <TextBlock Text=" " FontSize="11"/>
                                    <TextBlock Text="{Binding City}" Foreground="#6E7681" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Loss % with colour bar -->
                    <DataGridTemplateColumn Header="Loss %" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Background fill proportional to loss -->
                                    <Rectangle HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                               Fill="{Binding Loss, Converter={StaticResource LossToBrush}}"
                                               Opacity="0.15">
                                        <Rectangle.Width>
                                            <MultiBinding>
                                                <MultiBinding.Converter>
                                                    <conv:LossToWidthConverter/>
                                                </MultiBinding.Converter>
                                                <Binding Path="Loss"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}"
                                                         Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                    </Rectangle>
                                    <TextBlock Text="{Binding Loss, StringFormat='{}{0:F1}%'}"
                                               Foreground="{Binding Loss, Converter={StaticResource LossToBrush}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Sent -->
                    <DataGridTextColumn Header="Snt" Binding="{Binding Sent}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Recv -->
                    <DataGridTextColumn Header="Rcv" Binding="{Binding Received}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Last -->
                    <DataGridTemplateColumn Header="Last ms" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Last, Converter={StaticResource RttToStr}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#C9D1D9"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Avg -->
                    <DataGridTemplateColumn Header="Avg ms" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Avg, Converter={StaticResource RttToStr}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#E6EDF3"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Best -->
                    <DataGridTemplateColumn Header="Best ms" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Best, Converter={StaticResource BestRtt}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#3FB950"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Worst -->
                    <DataGridTemplateColumn Header="Wrst ms" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Worst, Converter={StaticResource RttToStr}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#F0883E"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Jitter -->
                    <DataGridTemplateColumn Header="Jitter ms" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Jitter, Converter={StaticResource RttToStr}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#8B949E"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- StdDev -->
                    <DataGridTemplateColumn Header="StdDev" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StdDev, Converter={StaticResource RttToStr}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#6E7681"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Flag -->
                    <DataGridTemplateColumn Header="Analysis" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Flag, Converter={StaticResource FlagToLabel}}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="#D29922"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- ── Splitter ───────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5"
                          Background="{StaticResource BrBorder}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- ── Right Panel ────────────────────────────────────────── -->
            <Grid Grid.Column="2" Background="{StaticResource BrPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Panel header -->
                    <RowDefinition Height="220"/>   <!-- Live chart -->
                    <RowDefinition Height="Auto"/>  <!-- Hop detail card -->
                    <RowDefinition Height="*"/>     <!-- Diagnosis -->
                </Grid.RowDefinitions>

                <!-- Panel header -->
                <Border Grid.Row="0" Background="#0C1117"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBlock Text="HOP ANALYSIS · LIVE CHART" Foreground="{StaticResource BrAccent}"
                               FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- LiveCharts2 latency graph -->
                <Border Grid.Row="1" Margin="8" Background="#0D1117"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <!-- Placeholder when nothing selected -->
                        <TextBlock Text="Select a hop to view latency history"
                                   Foreground="#484F58" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHop}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <lvc:CartesianChart Series="{Binding ChartSeries}"
                                            XAxes="{Binding ChartXAxes}"
                                            YAxes="{Binding ChartYAxes}"
                                            Background="Transparent"
                                            Margin="4">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="lvc:CartesianChart">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedHop}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- Hop detail card -->
                <Border Grid.Row="2" Margin="8,0,8,8"
                        Background="#0D1117"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="SELECTED HOP" Foreground="#484F58" FontSize="9"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- IP -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Foreground="#484F58" FontSize="10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedHop.IpAddress, FallbackValue='—'}"
                                       Foreground="{StaticResource BrAccent}" FontSize="12"/>

                            <!-- Host -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Host" Foreground="#484F58" FontSize="10" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedHop.HostName, FallbackValue='—'}"
                                       Foreground="{StaticResource BrText}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>

                            <!-- Geo -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Location" Foreground="#484F58" FontSize="10" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Foreground="#8B949E" FontSize="11" Margin="0,4,0,0">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocationDisplay}">
                                        <Binding Path="SelectedHop.City"    FallbackValue=""/>
                                        <Binding Path="SelectedHop.Country" FallbackValue=""/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Flag -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Foreground="#484F58" FontSize="10" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding SelectedHop.Flag, Converter={StaticResource FlagToLabel}, FallbackValue='—'}"
                                       Foreground="#D29922" FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnosis Panel -->
                <Border Grid.Row="3" Margin="8,0,8,8"
                        Background="#0D1117"
                        BorderBrush="{StaticResource BrBorder}" BorderThickness="1" CornerRadius="6"
                        Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PATH DIAGNOSIS"
                                   Foreground="#484F58" FontSize="9" Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding DiagnosisText}"
                                       Foreground="#8B949E" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="20"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             ROW 4 — Footer
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#010409"
                BorderBrush="{StaticResource BrBorder}" BorderThickness="0,1,0,0" Height="24">
            <Grid Margin="12,0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="10" Foreground="#484F58">
                    <Run Text="PortMTR Enterprise v1.0  ·  "/>
                    <Run Text="Npcap: " Foreground="#484F58"/>
                    <Run Text="Required for UDP" Foreground="#D29922"/>
                    <Run Text="  ·  GeoIP: " Foreground="#484F58"/>
                    <Run Text="GeoLite2-City.mmdb beside exe" Foreground="#6E7681"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="⚠ Administrator required for raw socket access"
                           FontSize="10" Foreground="#D29922"/>
            </Grid>
        </Border>
    </Grid>
</Window>
