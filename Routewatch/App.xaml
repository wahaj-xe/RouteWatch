<Application x:Class="RouteWatch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ── Base Palette (Default Night Cyberpunk) ── -->
        <Color x:Key="ColBg">#080B10</Color>
        <Color x:Key="ColPanel">#0D121B</Color>
        <Color x:Key="ColCardBg">#111824</Color>
        <Color x:Key="ColSubtleBg">#162030</Color>
        <Color x:Key="ColInputBg">#0E1420</Color>
        <Color x:Key="ColBorder">#223147</Color>
        <Color x:Key="ColAccent">#FFE600</Color>
        <Color x:Key="ColAccentGlow">#3300E5FF</Color>
        <Color x:Key="ColGreen">#00FF66</Color>
        <Color x:Key="ColYellow">#FFE600</Color>
        <Color x:Key="ColOrange">#FF7700</Color>
        <Color x:Key="ColRed">#FF0055</Color>
        <Color x:Key="ColMuted">#70889E</Color>
        <Color x:Key="ColText">#F0F8FF</Color>
        <Color x:Key="ColHeader">#00E5FF</Color>

        <SolidColorBrush x:Key="BrBg"         Color="{StaticResource ColBg}"/>
        <SolidColorBrush x:Key="BrPanel"      Color="{StaticResource ColPanel}"/>
        <SolidColorBrush x:Key="BrCardBg"     Color="{StaticResource ColCardBg}"/>
        <SolidColorBrush x:Key="BrSubtleBg"   Color="{StaticResource ColSubtleBg}"/>
        <SolidColorBrush x:Key="BrInputBg"    Color="{StaticResource ColInputBg}"/>
        <SolidColorBrush x:Key="BrBorder"     Color="{StaticResource ColBorder}"/>
        <SolidColorBrush x:Key="BrAccent"     Color="{StaticResource ColAccent}"/>
        <SolidColorBrush x:Key="BrAccentGlow" Color="{StaticResource ColAccentGlow}"/>
        <SolidColorBrush x:Key="BrGreen"      Color="{StaticResource ColGreen}"/>
        <SolidColorBrush x:Key="BrYellow"     Color="{StaticResource ColYellow}"/>
        <SolidColorBrush x:Key="BrOrange"     Color="{StaticResource ColOrange}"/>
        <SolidColorBrush x:Key="BrRed"        Color="{StaticResource ColRed}"/>
        <SolidColorBrush x:Key="BrMuted"      Color="{StaticResource ColMuted}"/>
        <SolidColorBrush x:Key="BrText"       Color="{StaticResource ColText}"/>
        <SolidColorBrush x:Key="BrHeader"     Color="{StaticResource ColHeader}"/>

        <!-- ── Global Font ── -->
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Segoe UI Variable, Segoe UI</FontFamily>

        <!-- ── TextBox style ── -->
        <Style TargetType="TextBox" x:Key="DarkInput">
            <Setter Property="Background"       Value="{DynamicResource BrInputBg}"/>
            <Setter Property="Foreground"       Value="{DynamicResource BrText}"/>
            <Setter Property="CaretBrush"       Value="{DynamicResource BrAccent}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,4"/>
            <Setter Property="FontFamily"       Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox style ── -->
        <Style TargetType="ComboBox" x:Key="DarkCombo">
            <Setter Property="Background"     Value="{DynamicResource BrInputBg}"/>
            <Setter Property="Foreground"     Value="{DynamicResource BrText}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="8,4"/>
            <Setter Property="FontFamily"     Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border x:Name="OuterBorder"
                                        Background="{DynamicResource BrInputBg}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          RecognizesAccessKey="True"
                                                          TextElement.Foreground="{DynamicResource BrText}"/>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource BrSubtleBg}"
                                                BorderBrush="{DynamicResource BrBorder}"
                                                BorderThickness="1,0,0,0">
                                            <Path Width="8" Height="5"
                                                  Stretch="Fill"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="{DynamicResource BrAccent}"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        Background="{DynamicResource BrCardBg}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger SourceName="DropDownToggle" Property="IsChecked" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- ── ComboBox item style ── -->
        <Style TargetType="ComboBoxItem" x:Key="DarkComboItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrSubtleBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrAccentGlow}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CheckBox style with Tri-State support ── -->
        <Style TargetType="CheckBox" x:Key="DarkCheckBox">
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border x:Name="boxBorder"
                                        Background="{DynamicResource BrInputBg}"
                                        BorderBrush="{DynamicResource BrBorder}"
                                        BorderThickness="1.5"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True"/>
                                <!-- Checkmark icon for Checked (true) -->
                                <Path x:Name="checkMark"
                                      Data="M 3 8 L 6 12 L 13 4"
                                      Stroke="{DynamicResource BrAccent}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                                <!-- Dash icon for Indeterminate (null) -->
                                <Border x:Name="dashMark"
                                        Background="{DynamicResource BrAccent}"
                                        Width="8" Height="2.5"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="dashMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="{DynamicResource BrHeader}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}"/>

        <!-- ── Label style ── -->
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="Foreground"  Value="{DynamicResource BrMuted}"/>
            <Setter Property="FontFamily"  Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Button base ── -->
        <Style TargetType="Button" x:Key="DarkButton">
            <Setter Property="Background"     Value="{DynamicResource BrCardBg}"/>
            <Setter Property="Foreground"     Value="{DynamicResource BrText}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="14,6"/>
            <Setter Property="FontFamily"     Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrSubtleBg}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrInputBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary / Start button ── -->
        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background"  Value="#12351D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrGreen}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrGreen}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1C4B2B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0E2816"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Action button (Alias to AccentButton) ── -->
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource AccentButton}"/>

        <!-- ── Stop button ── -->
        <Style TargetType="Button" x:Key="StopButton" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background"  Value="#35161A"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrRed}"/>
            <Setter Property="Foreground"  Value="{DynamicResource BrRed}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4A1C22"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#250F12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid ── -->
        <Style TargetType="DataGrid" x:Key="HopGrid">
            <Setter Property="Background"               Value="{DynamicResource BrCardBg}"/>
            <Setter Property="Foreground"               Value="{DynamicResource BrText}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrSubtleBg}"/>
            <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
            <Setter Property="RowBackground"            Value="{DynamicResource BrCardBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrSubtleBg}"/>
            <Setter Property="FontFamily"               Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="RowHeight"                Value="32"/>
            <Setter Property="ColumnHeaderHeight"       Value="36"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="EnableRowVirtualization"  Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"    Value="{DynamicResource BrPanel}"/>
            <Setter Property="Foreground"    Value="{DynamicResource BrHeader}"/>
            <Setter Property="FontFamily"    Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Padding"       Value="10,0"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BrBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Foreground"      Value="{DynamicResource BrText}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrAccentGlow}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrAccentGlow}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrSubtleBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Segmented Tab Pill Button ── -->
        <Style TargetType="RadioButton" x:Key="SegmentedTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrSubtleBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Sleek ScrollBar ── -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{DynamicResource BrBorder}"
                                CornerRadius="3"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BrMuted}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BrAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.LineRightCommand}" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
