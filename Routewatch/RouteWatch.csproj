<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RouteWatch</AssemblyName>
    <RootNamespace>RouteWatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Company>RouteWatch</Company>
    <Product>RouteWatch</Product>
    <Description>RouteWatch — Advanced Network Path Diagnostics &amp; Telemetry</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
    <Resource Include="Resources\app_badge.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packet capture (Npcap / WinPcap) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
    <PackageReference Include="PacketDotNet" Version="1.4.7" />

    <!-- GeoIP -->
    <PackageReference Include="MaxMind.GeoIP2" Version="5.1.0" />

    <!-- Live charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />

    <!-- MVVM toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- JSON for reporting -->
    <PackageReference Include="System.Text.Json" Version="9.0.8" />
  </ItemGroup>

  <!-- Embed GeoLite2 DB as content; user must supply it -->
  <ItemGroup>
    <Content Include="GeoLite2-City.mmdb" Condition="Exists('GeoLite2-City.mmdb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\GeoLite2-City.mmdb" Condition="Exists('Data\GeoLite2-City.mmdb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Data\GeoLite2-City.mmdb</TargetPath>
    </Content>
  </ItemGroup>

</Project>
